# ============================================
# SmartTest — Production Environment Variables
# Copy this file to .env.production and fill in real values
# ============================================

# ─── Application ───
PORT=3000
APP_URL=https://your-domain.com

# ─── Gemini AI API Keys (xoay vòng theo giờ) ───
GEMINI_API_KEY_1="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"
GEMINI_API_KEY_4="your-gemini-api-key-4"

# ─── JWT Authentication ───
# QUAN TRỌNG: Đổi thành chuỗi ngẫu nhiên mạnh (≥32 ký tự)
JWT_SECRET_KEY=smarttest-change-this-to-random-string-2026
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7

# ─── MySQL Database (Docker internal) ───
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=StrongPassword@2026
DB_NAME=quan_ly_sinh_de_ai_v2
# DB_SSL không cần khi dùng MySQL nội bộ Docker

# ─── Service URLs (Docker internal network) ───
EXAM_SERVICE_URL=http://exam:8001
AI_SERVICE_URL=http://ai:8002
ANALYTICS_SERVICE_URL=http://analytics:8003
AUTH_SERVICE_URL=http://auth:8004
QUANLYTHI_SERVICE_URL=http://quanlythi:8005
GATEWAY_PORT=8000
